# .env.example
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/regretnt
JWT_SECRET=replace-with-secure-secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENFORCE_HTTPS=false
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
GOAL_COMPLETE_RATE_LIMIT_MAX=30
GOAL_COMPLETE_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=debug
