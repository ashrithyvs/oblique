 import com.google.android.material.button.MaterialButton
 
 class PinSetupActivity : AppCompatActivity() {
+
+    private lateinit var pinView: PinView
+    private lateinit var togglePassword: ImageView
+    private lateinit var btnContinue: MaterialButton
+    private lateinit var tvPlainPin: TextView
+
     private var isPasswordVisible = false
+    private val maxDigits = 6
 
     override fun onCreate(savedInstanceState: Bundle?) {
         super.onCreate(savedInstanceState)
         setContentView(R.layout.activity_pin_setup)
 
-        val pinView = findViewById<PinView>(R.id.pinView)
-        val togglePassword = findViewById<ImageView>(R.id.togglePassword)
-        val btnContinue = findViewById<MaterialButton>(R.id.btnContinuePinSetup)
+        pinView = findViewById(R.id.pinView)
+        togglePassword = findViewById(R.id.togglePassword)
+        btnContinue = findViewById(R.id.btnContinuePinSetup)
+        tvPlainPin = findViewById(R.id.tvPlainPin)
+
+        // prevent soft keyboard (we use custom numpad)
+        pinView.showSoftInputOnFocus = false
+        pinView.isCursorVisible = false
+
+        setupNumpad()
+        updatePlainPinText()
 
         togglePassword.setOnClickListener {
             isPasswordVisible = !isPasswordVisible
-            pinView.inputType = if (isPasswordVisible) {
-                InputType.TYPE_CLASS_NUMBER
-            } else {
-                InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_VARIATION_PASSWORD
-            }
-            pinView.setSelection(pinView.text?.length ?: 0)
+            applyVisibilityState()
         }
 
         btnContinue.setOnClickListener {
-            val pin = pinView.text?.toString()?.trim()
-
-            if (pin.isNullOrEmpty() || pin.length != 6) {
+            val pin = pinView.text?.toString()?.trim() ?: ""
+            if (pin.length != maxDigits) {
                 Toast.makeText(this, "Please enter a 6-digit PIN", Toast.LENGTH_SHORT).show()
                 return@setOnClickListener
             }
-
             val intent = Intent(this, PinConfirmActivity::class.java)
             intent.putExtra("PIN", pin)
             startActivity(intent)
             finish()
         }
     }
+
+    private fun applyVisibilityState() {
+        if (isPasswordVisible) {
+            // show plain digits in the text view
+            tvPlainPin.visibility = View.VISIBLE
+            togglePassword.setImageResource(R.drawable.ic_eye_off) // you can supply a variant; fallback if missing
+            // Also set PinView to plain number so if keyboard somehow appears digits are visible there as well
+            pinView.inputType = InputType.TYPE_CLASS_NUMBER
+        } else {
+            tvPlainPin.visibility = View.GONE
+            togglePassword.setImageResource(R.drawable.ic_eye) // existing icon you had
+            pinView.inputType = InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_VARIATION_PASSWORD
+        }
+        updatePlainPinText()
+        // keep caret at end
+        pinView.setSelection(pinView.text?.length ?: 0)
+    }
+
+    private fun setupNumpad() {
+        val idsRow1 = listOf(R.id.btn1, R.id.btn2, R.id.btn3)
+        val idsRow2 = listOf(R.id.btn4, R.id.btn5, R.id.btn6)
+        val idsRow3 = listOf(R.id.btn7, R.id.btn8, R.id.btn9)
+        val idsRow4 = listOf(R.id.btnEmpty, R.id.btn0, R.id.btnBackspace)
+
+        val clickNumber: (String) -> Unit = letUnit@{ digit ->
+            val current = pinView.text?.toString() ?: ""
+            if (current.length >= maxDigits) return@letUnit
+            val next = current + digit
+            pinView.setText(next)
+            pinView.setSelection(next.length)
+            updatePlainPinText()
+        }
+
+        // numeric buttons 1..9
+        for (id in idsRow1 + idsRow2 + idsRow3) {
+            val b = findViewById<Button>(id)
+            b.setOnClickListener {
+                val text = b.text?.toString() ?: ""
+                val current = pinView.text?.toString() ?: ""
+                if (current.length >= maxDigits) return@setOnClickListener
+                val next = current + text
+                pinView.setText(next)
+                pinView.setSelection(next.length)
+                updatePlainPinText()
+            }
+        }
+
+        // row 4: empty, 0, backspace
+        findViewById<View>(R.id.btnEmpty).setOnClickListener { /* noop */ }
+
+        findViewById<Button>(R.id.btn0).setOnClickListener {
+            val current = pinView.text?.toString() ?: ""
+            if (current.length >= maxDigits) return@setOnClickListener
+            val next = current + "0"
+            pinView.setText(next)
+            pinView.setSelection(next.length)
+            updatePlainPinText()
+        }
+
+        findViewById<ImageButton>(R.id.btnBackspace).setOnClickListener {
+            val current = pinView.text?.toString() ?: ""
+            if (current.isEmpty()) return@setOnClickListener
+            val next = current.substring(0, current.length - 1)
+            pinView.setText(next)
+            pinView.setSelection(next.length)
+            updatePlainPinText()
+        }
+    }
+
+    // small helper to keep code brief
+    private val <T> T.letUnit: T get() = this
+
+    private fun updatePlainPinText() {
+        val cur = pinView.text?.toString() ?: ""
+        // show grouped text or plain digits when visibility enabled
+        tvPlainPin.text = if (cur.isEmpty()) "" else cur
+    }
 }
