+package com.example.oblique_android
+
+import android.graphics.BitmapFactory
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ImageButton
+import android.widget.ImageView
+import android.widget.ProgressBar
+import android.widget.TextView
+import androidx.cardview.widget.CardView
+import androidx.recyclerview.widget.RecyclerView
+
+class GoalsAdapter(private val listener: Listener) : RecyclerView.Adapter<GoalsAdapter.VH>() {
+
+    interface Listener {
+        fun onEdit(goal: GoalEntity)
+        fun onDelete(goal: GoalEntity)
+    }
+
+    private val items = mutableListOf<GoalEntity>()
+
+    fun submit(list: List<GoalEntity>) {
+        items.clear()
+        items.addAll(list)
+        notifyDataSetChanged()
+    }
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): VH {
+        val v = LayoutInflater.from(parent.context).inflate(R.layout.item_goal_card, parent, false)
+        return VH(v)
+    }
+
+    override fun onBindViewHolder(holder: VH, position: Int) {
+        val g = items[position]
+        holder.tvTitle.text = g.platformName
+        holder.tvSubtitle.text = "${g.dailyTarget} ${when (g.unit) {
+            "MINUTES" -> "minutes Daily"
+            "PROBLEMS" -> "problems Daily"
+            else -> "daily"
+        }}"
+        // progress
+        val prog = g.progress.coerceAtLeast(0)
+        holder.progressBar.max = g.dailyTarget.coerceAtLeast(1)
+        holder.progressBar.progress = prog.coerceAtMost(holder.progressBar.max)
+        holder.tvProgress.text = "${prog}/${holder.progressBar.max}"
+
+        holder.btnEdit.setOnClickListener { listener.onEdit(g) }
+        holder.btnDelete.setOnClickListener { listener.onDelete(g) }
+
+        // optional icon from blocked apps database (attempt to show)
+        holder.ivIcon.setImageResource(R.mipmap.ic_launcher)
+    }
+
+    override fun getItemCount(): Int = items.size
+
+    class VH(v: View) : RecyclerView.ViewHolder(v) {
+        val card: CardView = v.findViewById(R.id.cardGoal)
+        val ivIcon: ImageView = v.findViewById(R.id.ivIcon)
+        val tvTitle: TextView = v.findViewById(R.id.tvTitle)
+        val tvSubtitle: TextView = v.findViewById(R.id.tvSubtitle)
+        val progressBar: ProgressBar = v.findViewById(R.id.progressBar)
+        val tvProgress: TextView = v.findViewById(R.id.tvProgress)
+        val btnEdit: ImageButton = v.findViewById(R.id.btnEdit)
+        val btnDelete: ImageButton = v.findViewById(R.id.btnDelete)
+    }
+}
