+class GoalsActivity : AppCompatActivity(),
+    PlatformAdapter.OnPlatformClickListener,
+    GoalTypeAdapter.OnGoalTypeClickListener {
+
+    private lateinit var rvPlatforms: RecyclerView
+    private lateinit var rvGoalTypes: RecyclerView
+    private lateinit var inputTarget: EditText
+    private lateinit var btnTime: Button
+    private lateinit var btnAddThisGoal: Button
+    private lateinit var selectedPlatformCard: View
+    private lateinit var tvPlatformName: TextView
+    private lateinit var tvPlatformEmoji: TextView
+
+    private val repo by lazy { GoalRepository.getInstance(this) }
+    private var platforms = samplePlatforms()
+    private var selectedPlatform: Platform? = null
+    private var selectedGoalType: GoalType? = null
+    private var chosenDeadline: String? = null
+    private var editGoalId: Long? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_goals)
+
+        rvPlatforms = findViewById(R.id.rvPlatforms)
+        rvGoalTypes = findViewById(R.id.rvGoalTypes)
+        inputTarget = findViewById(R.id.inputTarget)
+        btnTime = findViewById(R.id.btnTime)
+        btnAddThisGoal = findViewById(R.id.btnAddThisGoal)
+        selectedPlatformCard = findViewById(R.id.selectedPlatformRow)
+        tvPlatformName = findViewById(R.id.platformName)
+        tvPlatformEmoji = findViewById(R.id.platformEmoji)
+
+        rvPlatforms.layoutManager = GridLayoutManager(this, 2)
+        rvPlatforms.adapter = PlatformAdapter(platforms, this)
+
+        rvGoalTypes.layoutManager = LinearLayoutManager(this)
+        rvGoalTypes.adapter = GoalTypeAdapter(emptyList(), this)
+
+        // time picker
+        btnTime.setOnClickListener {
+            val cal = Calendar.getInstance()
+            TimePickerDialog(this, { _, h, m ->
+                chosenDeadline = String.format("%02d:%02d", h, m)
+                btnTime.text = chosenDeadline
+            }, cal.get(Calendar.HOUR_OF_DAY), cal.get(Calendar.MINUTE), true).show()
+        }
+
+        btnAddThisGoal.setOnClickListener {
+            val platform = selectedPlatform
+            val gtype = selectedGoalType
+            if (platform == null || gtype == null) {
+                Toast.makeText(this, "Select platform and goal type", Toast.LENGTH_SHORT).show()
+                return@setOnClickListener
+            }
+            val raw = inputTarget.text?.toString()?.trim()
+            val t = raw?.toIntOrNull()
+            if (t == null || t <= 0) {
+                Toast.makeText(this, "Enter a valid target", Toast.LENGTH_SHORT).show()
+                return@setOnClickListener
+            }
+
+            lifecycleScope.launch {
+                if (editGoalId != null) {
+                    // update existing
+                    val existing = repo.getById(editGoalId!!)
+                    if (existing != null) {
+                        val updated = existing.copy(
+                            platformName = platform.name,
+                            platformPackage = null,
+                            title = gtype.title,
+                            unit = gtype.unit.name,
+                            dailyTarget = t,
+                            deadline = chosenDeadline,
+                            progress = existing.progress // preserve progress
+                        )
+                        repo.update(updated)
+                    }
+                } else {
+                    val newGoal = GoalEntity(
+                        platformName = platform.name,
+                        platformPackage = null,
+                        title = gtype.title,
+                        unit = gtype.unit.name,
+                        dailyTarget = t,
+                        deadline = chosenDeadline,
+                        progress = 0
+                    )
+                    repo.insert(newGoal)
+                }
+                setResult(Activity.RESULT_OK)
+                finish()
+            }
+        }
+
+        // if editing
+        editGoalId = intent.getLongExtra("edit_goal_id", -1L).takeIf { it != -1L }
+        if (editGoalId != null) {
+            lifecycleScope.launch {
+                val g = repo.getById(editGoalId!!)
+                g?.let { loadForEdit(it) }
+            }
+        }
+    }
+
+    private fun loadForEdit(goal: GoalEntity) {
+        // pre-select platform if found by name
+        selectedPlatform = platforms.firstOrNull { it.name.equals(goal.platformName, true) }
+        selectedPlatform?.let {
+            tvPlatformEmoji.text = it.emoji
+            tvPlatformName.text = it.name
+            selectedPlatformCard.isVisible = true
+            (rvPlatforms.adapter as? PlatformAdapter)?.setSelected(it)
+            (rvGoalTypes.adapter as? GoalTypeAdapter)?.update(it.suggestions)
+            selectedGoalType = it.suggestions.firstOrNull { s -> s.title == goal.title }
+            (rvGoalTypes.adapter as? GoalTypeAdapter)?.setSelected(selectedGoalType)
+        }
+
+        inputTarget.setText(goal.dailyTarget.toString())
+        chosenDeadline = goal.deadline
+        btnTime.text = chosenDeadline ?: "--:-- --"
+    }
+
+    // Platform clicks
+    override fun onPlatformClick(platform: Platform) {
+        selectedPlatform = platform
+        // show selected row UI
+        selectedPlatformCard.isVisible = true
+        tvPlatformEmoji.text = platform.emoji
+        tvPlatformName.text = platform.name
+
+        (rvGoalTypes.adapter as? GoalTypeAdapter)?.update(platform.suggestions)
+        // scroll to goal types
+        rvGoalTypes.post { rvGoalTypes.scrollToPosition(0) }
+    }
+
+    // Goal type clicks
+    override fun onGoalTypeClick(goalType: GoalType) {
+        selectedGoalType = goalType
+        // prefill suggestion
+        inputTarget.setText(goalType.suggested.toString())
+    }
+
+    // Sample platforms (use your real icons if available)
+    private fun samplePlatforms(): List<Platform> {
+        return listOf(
+            Platform("LeetCode","💻", listOf(
+                GoalType("Solve coding problems", "Suggested: 2 problems", TargetUnit.PROBLEMS, 2),
+                GoalType("Study time", "Suggested: 30 minutes", TargetUnit.MINUTES, 30)
+            )),
+            Platform("Duolingo","🧠", listOf(
+                GoalType("Complete lessons","Suggested: 2 lessons", TargetUnit.COUNT, 2),
+                GoalType("Study time","Suggested: 20 minutes", TargetUnit.MINUTES, 20)
+            )),
+            Platform("Reading","📖", listOf(
+                GoalType("Read pages","Suggested: 10 pages", TargetUnit.COUNT, 10),
+                GoalType("Reading time","Suggested: 30 minutes", TargetUnit.MINUTES, 30)
+            )),
+            Platform("Exercise","💪", listOf(
+                GoalType("Workout time","Suggested: 30 minutes", TargetUnit.MINUTES, 30)
+            ))
+        )
+    }
+}
