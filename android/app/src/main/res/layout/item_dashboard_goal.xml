<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardGoal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Icon -->
        <ImageView
            android:id="@+id/ivGoalIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_meditation"
            android:contentDescription="goal icon"
            android:background="@drawable/circle_gray"
            android:padding="8dp" />

        <!-- Goal details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvGoalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meditation"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvGoalPeriodStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <!-- Progress row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Progress bar container: rounded track + filled view + glow overlay -->
                <FrameLayout
                    android:id="@+id/progressContainer"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/progress_track"
                    android:clipToPadding="false"
                    android:clipToOutline="true">

                    <!-- Filled portion (width will be adjusted programmatically) -->
                    <View
                        android:id="@+id/viewProgressFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left"
                        android:backgroundTint="@color/accent_green"
                        android:background="@drawable/progress_fill"
                        android:importantForAccessibility="no" />

                    <!-- Glow overlay, same width as filled portion; animated alpha/scale for pulse -->
                    <View
                        android:id="@+id/viewProgressGlow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left"
                        android:background="@drawable/progress_glow"
                        android:alpha="0"
                        android:visibility="visible"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvGoalProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/2"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
