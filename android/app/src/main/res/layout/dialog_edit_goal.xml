<!-- res/layout/dialog_edit_goal.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <EditText
        android:id="@+id/etEditTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="New target value"
        android:inputType="number" />

    <TextView
        android:id="@+id/tvDeadlinePreviewEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="No deadline selected"
        android:textSize="16sp"
        android:textColor="@color/text_muted"
        android:layout_margin="16dp" />
    <Button
        android:id="@+id/btnPickDeadlineEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Pick Deadline Time"
        android:background="@drawable/btn_dark_pill"
        android:textColor="@color/white"
        android:textAllCaps="false" />
</LinearLayout>
