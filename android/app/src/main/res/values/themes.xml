<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Oblique.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/theme_primary</item>
        <item name="colorOnPrimary">@color/theme_on_primary</item>
        <item name="colorSecondary">@color/theme_secondary</item>
        <item name="colorOnSecondary">@color/theme_on_secondary</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>
        <item name="colorOutline">@color/theme_outline</item>
        <item name="colorSurfaceContainer">@color/theme_surface</item>
        <item name="colorSurfaceContainerLow">@color/theme_surface</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface</item>
        <item name="colorSurfaceContainerHighest">@color/theme_surface</item>
        <item name="colorSurfaceVariant">@color/divider_light</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialButtonStyle">@style/Widget.Oblique.Button.Primary</item>
        <item name="sliderStyle">@style/Widget.Oblique.Slider</item>
        <item name="materialCardViewStyle">@style/Widget.Oblique.Card</item>
    </style>

    <!-- App base theme -->
    <style name="Theme.Oblique" parent="Theme.Oblique.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SplashScreen theme (must extend AppCompat-compatible theme) -->
    <style name="Theme.Oblique.Splash" parent="Theme.Oblique.Base">
        <!-- Splash screen attributes (Android 12+) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenBackground">@color/black</item>
        <!-- After splash, switch to main app theme -->
        <item name="postSplashScreenTheme">@style/Theme.Oblique</item>
    </style>

    <!-- Dashboard with safe insets applied in Activity code -->
    <style name="Theme.Oblique.NoEdgeToEdge" parent="Theme.Oblique.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
